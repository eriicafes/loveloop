# Local only: cmd/local's port.
PORT=8100

# Telegram: create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Required to connect the webhook: 1-256 characters of A-Z, a-z, 0-9, _ and -.
# Telegram sends it with every update.
TELEGRAM_WEBHOOK_SECRET=
# Optional comma separated Telegram user IDs allowed to chat; empty allows anyone.
TELEGRAM_ALLOWED_USERS=
# Password for the setup page and /_workflow; empty disables sign in. Changing
# it signs everyone out.
SETUP_PASSWORD=

# Set by the Upstash Redis integration; shared by LoveLoop's data and the
# workflow World.
REDIS_URL=

# The AI Gateway authenticates with the deployment's OIDC token, or with
# AI_GATEWAY_API_KEY when it is set. MODEL defaults to anthropic/claude-sonnet-5.5.
AI_GATEWAY_API_KEY=
MODEL=

# Optional: signs tool approval requests (at least 32 random bytes). Changing it
# invalidates approvals still waiting for an answer.
TOOL_APPROVAL_SECRET=

# Workflow SDK web UI at /_workflow, for browsers signed in to the setup page.
# It reads runs through the World's RPC endpoint at WORKFLOW_HTTP_BASE_URL (your
# production domain plus /v1/workflow), sending WORKFLOW_HTTP_TOKEN as its
# bearer token; an empty token closes the endpoint.
WORKFLOW_TARGET_WORLD=go-workflow/world-http
WORKFLOW_HTTP_TOKEN=
WORKFLOW_HTTP_BASE_URL=https://your-app.vercel.app/v1/workflow
