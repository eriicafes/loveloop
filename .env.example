# Telegram: create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Any random string; Telegram echoes it on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Password for the setup page's sign in.
SETUP_PASSWORD=
# Optional comma separated Telegram user IDs allowed to use the bot.
TELEGRAM_ALLOWED_USERS=

# Redis (Upstash works) for LoveLoop's data and the workflow World.
REDIS_URL=rediss://default:password@host:6379

# Model. On Vercel the AI Gateway authenticates with OIDC, so no key is needed.
AI_GATEWAY_API_KEY=
# Used instead of the gateway when AI_GATEWAY_API_KEY is empty.
ANTHROPIC_API_KEY=
MODEL=anthropic/claude-sonnet-5.5

# Signs tool approval requests (at least 32 random bytes).
TOOL_APPROVAL_SECRET=

# Vercel only. Defaults: https://$VERCEL_PROJECT_PRODUCTION_URL/v1/workflow,
# https://$VERCEL_REGION.vercel-queue.com/api/v3, and loveloop-workflow.
WORKFLOW_BASE_URL=
VERCEL_QUEUE_URL=
VERCEL_WORKFLOW_QUEUE_TOPIC=
# Optional: only needed for timers over 7 days; reminders already sleep in
# 6 day steps without it.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
